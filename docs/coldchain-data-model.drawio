        <mxCell id="r27" value="backs the finding" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=ERoneToMany;endFill=0;startArrow=ERone;startFill=0;strokeWidth=2;dashed=1;strokeColor=#9673a6;fontColor=#6a4c86;" edge="1" parent="1" source="n-excursion" target="n-certificate_finding"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="r28" value="backs the verdict" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=ERoneToMany;endFill=0;startArrow=ERone;startFill=0;strokeWidth=2;strokeColor=#555555;fontColor=#444444;" edge="1" parent="1" source="n-compliance_certificate" target="n-certificate_finding"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="leg" value="&lt;b style=&quot;font-size: 14px;&quot;&gt;HOW TO READ THIS MAP&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Thick border&lt;/b&gt; = core table, there is no product without it.&lt;br&gt;&lt;b&gt;Thin dashed border&lt;/b&gt; = table you could cut from a showcase build.&lt;br&gt;&lt;br&gt;&lt;b&gt;Solid line&lt;/b&gt; = a real foreign key inside the module.&lt;br&gt;&lt;b&gt;Dashed purple line&lt;/b&gt; = a reference by identifier across modules.&lt;br&gt;There is a column holding the UUID, but no FK and no join: you ask the other module through its port.&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#d79b00&quot;&gt;❄&lt;/font&gt; marks a frozen snapshot column.&lt;br&gt;&lt;b&gt;Every&lt;/b&gt; table carries id RAW(16), created_at and updated_at." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=14;spacingTop=12;fontSize=12;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="1210" width="560" height="230" as="geometry" /></mxCell>
        <mxCell id="cnt" value="&lt;b style=&quot;font-size: 14px;&quot;&gt;THE COUNT&lt;/b&gt;&lt;br&gt;&lt;br&gt;identity&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;8 tables&lt;br&gt;catalog&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;3 tables&lt;br&gt;shipment&amp;nbsp;&amp;nbsp;5 tables&lt;br&gt;telemetry&amp;nbsp;5 tables&lt;br&gt;compliance 2 tables&lt;br&gt;&lt;br&gt;&lt;b style=&quot;font-size: 16px;&quot;&gt;TOTAL: 23 tables&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;i&gt;Core, non-negotiable: 19.&lt;br&gt;Cuttable without losing the thread: 4&lt;br&gt;(role_scope, api_client_scope, audit_entry, site).&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=14;spacingTop=12;fontSize=12;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="640" y="1210" width="400" height="230" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
