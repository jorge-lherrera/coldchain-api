# Copy to .env before `docker compose up -d`. The .env file is git-ignored (R9.16).
ORACLE_SYSTEM_PASSWORD=change-me-system
DB_USERNAME=coldchain
DB_PASSWORD=change-me-app
DB_URL=jdbc:oracle:thin:@//localhost:1521/FREEPDB1
# At least 32 characters. Generate one with: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-characters
# The triage service's own PostgreSQL (ADR-010).
TRIAGE_DB_NAME=triage
TRIAGE_DB_USERNAME=triage
TRIAGE_DB_PASSWORD=change-me-triage
# The platform credential triage uses to read the excursion context (ADR-011).
# The API holds only the Argon2id hash; triage holds the secret. Replace both together, and keep
# the hash in single quotes so Compose does not read its dollar signs as variables.
PLATFORM_CLIENT_ID=coldchain-triage
PLATFORM_CLIENT_SECRET=change-me-platform-secret
PLATFORM_CLIENT_SECRET_HASH='$argon2id$v=19$m=16384,t=2,p=1$jM3fSzAsN/yoLnGMRSBgYg$oDYYdqi1/yC8tHhqHoG1qi/JHPkwIZqPV04Iqyu0qZs'
# Optional. With a key, triage asks the model for the probable cause of a closed excursion; without
# one, the rules answer and everything else works the same (ADR-012).
ANTHROPIC_API_KEY=
